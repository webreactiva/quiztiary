# Copy to .env. Secrets and per-machine settings live here; host choices live in quiztiary.config.mjs.

# Required: password for /panel. Without it nobody can read or mark questions.
PANEL_PASSWORD=

# Only with ai: 'jev' in quiztiary.config.mjs. Free key at https://console.typesafe.ai/keys
JEV_API_KEY=

# Optional: fixed public address for the panel QR (own domain, named tunnel, deploy).
# Leave empty to read it from the Cloudflare quick tunnel.
PUBLIC_URL=

# Optional overrides
# PORT=4321
# DB_PATH=quiztiary.db
# RELEASE_DELAY=20-90
# TUNNEL_METRICS_PORT=20241

# Only with ai: 'clef' (Clef on Cloudflare Workers AI). Token with "Workers AI: Read" at
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLEF_MODEL=clef-flash
