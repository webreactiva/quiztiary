---
import config from '../../quiztiary.config.mjs';
import { locale } from '../i18n/index.ts';
import { icon } from '../badges/icon.mjs';
import { paletteCss } from '../lib/palette.mjs';
import '../styles.css';

const { title = config.name, noindex = false } = Astro.props;
const favicon = `data:image/svg+xml,${encodeURIComponent(icon(config.colors.accent))}`;
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={favicon} />
    <style set:html={paletteCss(config.colors)}></style>
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
